# Site
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43134
NEXT_PUBLIC_WHATSAPP=4915217251813
NEXT_PUBLIC_CONTACT_EMAIL=
SHOW_FULL_ADDRESS=false

# Atelier (used when Supabase is unset, or as a house-key fallback)
# Set a unique value locally before enabling admin access.
ADMIN_PASSWORD=
# First email promoted to admin on sign-in / sign-up
ADMIN_EMAIL=

# Supabase — never put the service role key in NEXT_PUBLIC_* vars
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional alias for older projects
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional alias
# SUPABASE_SECRET_KEY=

# Stripe (card checkout). COD / transfer / WhatsApp still work without these.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# OTP store in production. Local dev uses an in-memory map.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Cron
CRON_SECRET=

# Optional storefront flags (quote the value — the token can contain $)
# GLOBAL_CONFIG=

# Analytics (optional)
# POSTHOG_ANALYTICS_API_KEY=
# POSTHOG_ANALYTICS_HOST=
